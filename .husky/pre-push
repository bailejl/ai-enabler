# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Read it once so the guard and the delete check below both see it.
refs=$(cat)

# Refuse prototype branches before the slow tests
printf '%s\n' "$refs" | node scripts/proto-push-guard-cli.js

# A delete sends an all-zero local sha. Skip the tests when every ref is a delete.
if [ -n "$refs" ] && printf '%s\n' "$refs" | awk '$2 !~ /^0+$/ { found = 1 } END { exit found }'; then
  echo "pre-push: only branch deletes, skipping tests"
  exit 0
fi

npm test
npm run test:e2e
