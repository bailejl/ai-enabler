{
  "name": "ai-enabler",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "vite",
    "dev:prototype": "vite --mode prototype --port 3001 --strictPort=false",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:deep": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "mcp": "node mcp/server.js",
    "build:plugin": "vite build -c vite.mcp.config.js",
    "check:plugin": "node scripts/plugin-bundle-check-cli.js",
    "test:gate": "vitest run --reporter=dot",
    "test:e2e:gate": "playwright test --reporter=dot",
    "test:gate:guides": "vitest run --reporter=verbose src/flow/diagnostics mcp/guides.test.js",
    "test:gate:repair-tool": "vitest run --reporter=verbose mcp/tools.test.js mcp/server.test.js mcp/plugin-bundle.test.js mcp/docs.test.js",
    "test:gate:deploy": "vitest run --reporter=verbose scripts/deploy-workflow.test.js scripts/readme.test.js",
    "test:gate:routes": "vitest run --reporter=verbose src/shell/routes.test.js",
    "test:e2e:gate:routes": "playwright test --reporter=list --project=chromium e2e/routes.spec.js",
    "test:e2e:gate:pages": "playwright test --reporter=list --project=pages",
    "lint:ci": "action-validator .github/workflows/ci.yml && action-validator .github/workflows/deploy.yml && action-validator .github/actions/setup/action.yml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bailejl/ai-enabler.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/bailejl/ai-enabler/issues"
  },
  "homepage": "https://github.com/bailejl/ai-enabler#readme",
  "devDependencies": {
    "@action-validator/cli": "^0.6.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
